# Install as /etc/backburner/server.env with owner root:root and mode 0600.
# Generate independent random values for the two keys. Never commit real keys.
ASPNETCORE_URLS=http://0.0.0.0:5080
BackBurner__DataFile=/var/lib/backburner/backburner-state.json
BackBurner__RequireAuthentication=true
BackBurner__AdminApiKey=replace-with-a-random-admin-key
BackBurner__WorkerApiKey=replace-with-a-different-random-worker-key
# Optional read-only source root used by the directory-batch scanner.
BackBurner__SourceRoots__nas-media=/volume1/Plex
